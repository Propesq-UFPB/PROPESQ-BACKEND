# Copie para .env e ajuste se necessário:
#   cp .env.example .env

PORT=3000

# Origem permitida no CORS (front de desenvolvimento)
CORS_ORIGIN=http://localhost:3100

DATABASE_USER=propesq
DATABASE_PASSWORD=propesq
DATABASE_NAME=propesq
DATABASE_PORT=5432

# Host: porta publicada no docker-compose-dev (5433 -> 5432 no container)
DATABASE_URL=postgres://propesq:propesq@localhost:5433/propesq
