generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model anexo {
  id            Int      @id @default(autoincrement())
  usuario_id    Int
  arquivo       Bytes
  tipo          String   @db.VarChar(255)
  criado_em     DateTime @default(now()) @db.Timestamp(6)
  atualizado_em DateTime @default(now()) @updatedAt @db.Timestamp(6)
  usuario       usuario  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model anexo_projeto_pesquisa {
  id                  Int               @id @default(autoincrement())
  projeto_pesquisa_id Int               @unique
  arquivo             Bytes
  tipo                String            @db.VarChar(255)
  projeto_pesquisa    projeto_pesquisa? @relation(fields: [projeto_pesquisa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model area_conhecimento {
  id               Int                @id @default(autoincrement())
  grande_area      String
  area             String
  sub_area         String
  especialidade    String
  projeto_pesquisa projeto_pesquisa[]
  docentes         docente[]
  grupoPesquisas   grupo_pesquisa[]
}

model atividade_projeto_pesquisa {
  id                  Int                    @id @default(autoincrement())
  descricao           String                 @db.Text
  meses               mes_projeto_pesquisa[]
  projeto_pesquisa_id Int?
  projeto_pesquisa    projeto_pesquisa?      @relation(fields: [projeto_pesquisa_id], references: [id], onDelete: Cascade)
}

model mes_projeto_pesquisa {
  id           Int                        @id @default(autoincrement())
  data         DateTime                   @db.Date
  atividade_id Int
  atividade    atividade_projeto_pesquisa @relation(fields: [atividade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model atividade_plano_trabalho {
  id                Int                  @id @default(autoincrement())
  descricao         String               @db.Text
  meses             mes_plano_trabalho[]
  plano_trabalho_id Int?
  plano_trabalho    plano_trabalho?      @relation(fields: [plano_trabalho_id], references: [id], onDelete: Cascade)
}

model mes_plano_trabalho {
  id                         Int                       @id @default(autoincrement())
  data                       DateTime                  @db.Date
  atividade_id               Int
  atividadePlanoTrabalho     atividade_plano_trabalho? @relation(fields: [atividade_plano_trabalhoId], references: [id], onDelete: Cascade)
  atividade_plano_trabalhoId Int?
}

model corpo_plano_trabalho {
  id                Int            @id @default(autoincrement())
  titulo            String
  introducao        String
  objetivos         String
  metodologia       String
  referencias       String
  plano_trabalho_id Int            @unique
  plano_trabalho    plano_trabalho @relation(fields: [plano_trabalho_id], references: [id], onDelete: Cascade)
}

model corpo_projeto {
  id                  Int              @id @default(autoincrement())
  resumo              String
  abstract            String
  introducao          String
  objetivos           String
  metodologia         String
  referencias         String
  projeto_pesquisa_id Int              @unique
  projeto_pesquisa    projeto_pesquisa @relation(fields: [projeto_pesquisa_id], references: [id], onDelete: Cascade)
}

model discente {
  id               Int                        @id @default(autoincrement())
  usuario_id       Int
  matricula        String?                    @db.VarChar(50)
  lattes_url       String?                    @db.VarChar(500)
  usuario          usuario                    @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plano_trabalho   plano_trabalho[]
  interesses_plano interesse_plano_trabalho[]
  perfil           perfil_discente?
}

model perfil_discente {
  id                  Int       @id @default(autoincrement())
  discente_id         Int       @unique
  data_nascimento     DateTime? @db.Date
  sexo                String?   @db.VarChar(20)
  raca                String?   @db.VarChar(50)
  estado_civil        String?   @db.VarChar(50)
  nacionalidade       String?   @db.VarChar(100)
  naturalidade        String?   @db.VarChar(150)
  tipo_sanguineo      String?   @db.VarChar(10)
  nome_pai            String?   @db.VarChar(255)
  nome_mae            String?   @db.VarChar(255)
  cpf                 String?   @db.VarChar(14)
  rg                  String?   @db.VarChar(30)
  rg_emissao          DateTime? @db.Date
  orgao_emissor       String?   @db.VarChar(50)
  titulo_eleitor      String?   @db.VarChar(30)
  zona_eleitoral      String?   @db.VarChar(10)
  secao_eleitoral     String?   @db.VarChar(10)
  certificado_militar String?   @db.VarChar(50)
  categoria_militar   String?   @db.VarChar(50)
  cep                 String?   @db.VarChar(12)
  tipo_logradouro     String?   @db.VarChar(30)
  logradouro          String?   @db.VarChar(255)
  numero              String?   @db.VarChar(20)
  complemento         String?   @db.VarChar(100)
  bairro              String?   @db.VarChar(100)
  uf                  String?   @db.VarChar(50)
  cidade              String?   @db.VarChar(100)
  pais                String?   @db.VarChar(100)
  telefone_ddd        String?   @db.VarChar(5)
  telefone            String?   @db.VarChar(20)
  celular_ddd         String?   @db.VarChar(5)
  celular             String?   @db.VarChar(20)
  curso               String?   @db.VarChar(255)
  campus              String?   @db.VarChar(100)
  periodo             String?   @db.VarChar(50)
  semestre            String?   @db.VarChar(20)
  cra                 Decimal?  @db.Decimal(4, 2)
  creditos_concluidos Int?
  reprovacoes         Int?
  situacao_academica  String?   @db.VarChar(50)
  situacao_matricula  String?   @db.VarChar(50)
  possui_necessidade  Boolean   @default(false)
  tipo_necessidade    String?   @db.VarChar(255)
  atualizado_em       DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  discente discente @relation(fields: [discente_id], references: [id], onDelete: Cascade)
}

model docente {
  id                   Int                @id @default(autoincrement())
  usuario_id           Int
  usuario              usuario            @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  area_conhecimento    area_conhecimento? @relation(fields: [area_conhecimento_id], references: [id])
  area_conhecimento_id Int?
}

model edital {
  id                              Int           @id @default(autoincrement())
  codigo                          String?       @unique @db.VarChar(255)
  descricao                       String        @db.Text
  status                          StatusEdital  @default(RASCUNHO)
  ano                             Int
  cota_bolsa_id                   Int
  titulacao_min                   TitulacaoMin
  tipo                            TipoEdital
  limite_solicitacoes_orientador  Int
  limite_planos_orientador        Int
  avaliacao_vigente               Boolean
  apenas_orient_coordena_plano    Boolean
  tec_admin_coord_proj            Boolean
  divulgar_resultado              Boolean       @default(false)
  edital_para_voluntarios         Boolean       @default(false)
  apenas_colab_vol_cadastra_plano Boolean       @default(false)
  prof_subst_cadastra_proj        Boolean       @default(false)
  periodo_submissoes_id           Int
  periodo_execucao_id             Int
  categoria_id                    Int
  data_cadastro                   DateTime
  anexo                           anexo_edital?

  periodo_submissoes       periodo_edital             @relation("periodo_submissoes", fields: [periodo_submissoes_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodo_execucao_rel     periodo_edital             @relation("periodo_execucao", fields: [periodo_execucao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  edital_cota_distribuicao edital_cota_distribuicao[]
  edital_unidade_academica edital_unidade_academica[]
  projetos_pesquisa        projeto_pesquisa[]
  categoria                categoria_edital           @relation(fields: [categoria_id], references: [id])
  cota_bolsa               cota_bolsa                 @relation(fields: [cota_bolsa_id], references: [id])
}

model anexo_edital {
  id        Int     @id @default(autoincrement())
  edital_id Int     @unique
  nome      String  @unique @db.VarChar(255)
  arquivo   Bytes
  tipo      String  @db.VarChar(255)
  edital    edital? @relation(references: [id], fields: [edital_id], onDelete: Cascade)
}

model edital_unidade_academica {
  id         Int               @id @default(autoincrement())
  edital_id  Int
  unidade_id Int
  edital     edital            @relation(fields: [edital_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unidade    unidade_academica @relation(fields: [unidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([edital_id, unidade_id])
}

model edital_cota_distribuicao {
  id                                 Int     @id @default(autoincrement())
  id_edital                          Int
  id_bolsa                           Int
  quantidade                         Int
  fppi_min                           Float
  fppi_max                           Float?
  media_min_proj                     Float
  exige_doutorado                    Boolean
  percentual_cotas_novos_doutorandos Float?
  fppi_min_novos_doutorandos         Float?
  fppi_max_novos_doutorandos         Float?

  edital edital @relation(fields: [id_edital], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bolsa  bolsa  @relation(fields: [id_bolsa], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model periodo_edital {
  id                 Int      @id @default(autoincrement())
  inicio             DateTime @db.Date
  fim                DateTime @db.Date
  editais_submissoes edital[] @relation("periodo_submissoes")
  editais_execucao   edital[] @relation("periodo_execucao")
}

model unidade_academica {
  id                       Int                        @id @default(autoincrement())
  sigla                    String                     @unique @db.VarChar(15)
  nome                     String                     @unique @db.VarChar(255)
  ativo                    Boolean                    @default(true)
  projetoPesquisas         projeto_pesquisa[]
  departamentos            departamento[]
  edital_unidade_academica edital_unidade_academica[]
}

model departamento {
  id         Int               @id @default(autoincrement())
  sigla      String            @db.VarChar(15)
  nome       String            @db.VarChar(255)
  ativo      Boolean           @default(true)
  unidade_id Int
  unidade    unidade_academica @relation(fields: [unidade_id], references: [id], onDelete: Cascade)

  @@unique([unidade_id, sigla])
  @@unique([unidade_id, nome])
}

model palavra_chave {
  id                 Int               @id @default(autoincrement())
  palavra_chave      String
  lingua             Idioma
  projetoPesquisa    projeto_pesquisa? @relation(fields: [projeto_pesquisaId], references: [id], onDelete: Cascade)
  projeto_pesquisaId Int?
}

model permissao {
  id               Int                @id @default(autoincrement())
  nome             String             @unique
  descricao        String?
  criado_em        DateTime           @default(now()) @db.Timestamp(6)
  atualizado_em    DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  funcao_permissao funcao_permissao[]
}

model plano_trabalho {
  id                       Int                        @id @default(autoincrement())
  discente_id              Int?
  usuario_id               Int?
  modalidade               String                     @db.VarChar(255)
  status                   String
  tipo_bolsa               String                     @db.VarChar(255)
  cronograma_id            Int?
  direcionamento_plano     String
  corpo_id                 Int?
  pesquisa_id              Int
  status_indicacao         StatusIndicacaoPlano       @default(PENDENTE_INDICACAO)
  vagas                    Int                        @default(1)
  carga_horaria            Int?
  prazo_indicacao          DateTime?                  @db.Date
  prazo_substituicao       DateTime?                  @db.Date
  tipo_indicacao           TipoIndicacao?
  status_termo_compromisso StatusTermoCompromisso?    @default(NAO_ENVIADO)
  atividades               atividade_plano_trabalho[]
  corpo_plano_trabalho     corpo_plano_trabalho?
  discente                 discente?                  @relation(fields: [discente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario                  usuario?                   @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projeto_pesquisa         projeto_pesquisa           @relation(fields: [pesquisa_id], references: [id], onDelete: Cascade)
  interesses               interesse_plano_trabalho[]
  dados_bancarios          dados_bancarios_indicacao?
}

model interesse_plano_trabalho {
  id                Int                  @id @default(autoincrement())
  plano_trabalho_id Int
  discente_id       Int
  status            StatusInteressePlano @default(INTERESSE_REGISTRADO)
  criado_em         DateTime             @default(now()) @db.Timestamp(6)
  atualizado_em     DateTime             @default(now()) @updatedAt @db.Timestamp(6)

  plano_trabalho plano_trabalho @relation(fields: [plano_trabalho_id], references: [id], onDelete: Cascade)
  discente       discente       @relation(fields: [discente_id], references: [id], onDelete: Cascade)

  @@unique([plano_trabalho_id, discente_id])
}

model dados_bancarios_indicacao {
  id                Int      @id @default(autoincrement())
  plano_trabalho_id Int      @unique
  usuario_id        Int?
  banco             String   @db.VarChar(255)
  agencia           String   @db.VarChar(50)
  conta             String   @db.VarChar(50)
  criado_em         DateTime @default(now()) @db.Timestamp(6)
  atualizado_em     DateTime @default(now()) @updatedAt @db.Timestamp(6)

  plano_trabalho plano_trabalho @relation(fields: [plano_trabalho_id], references: [id], onDelete: Cascade)
  usuario        usuario?       @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model projeto_pesquisa {
  id                Int             @id @default(autoincrement())
  codigo            String
  tipo              TipoProjeto
  titulo            String
  title             String
  categoria_id      Int
  situacao          SituacaoProjeto @map("situação")
  email             String
  data_inicio       DateTime?       @db.Timestamp(6)
  data_fim          DateTime?       @db.Timestamp(6)
  vigencia          DateTime        @db.Timestamp(6)
  data_cadastro     DateTime
  cota              String?
  numero_protocolo  String?         @db.VarChar(255)
  comite_etica      String?         @db.VarChar(255)
  linha_pesquisa    String?         @db.VarChar(512)
  pontuacao_final   Float?
  edital_id         Int?
  grupo_pesquisa_id Int?
  grupo_pesquisa    grupo_pesquisa? @relation(fields: [grupo_pesquisa_id], references: [id])

  unidade_id        Int
  unidade_academica unidade_academica @relation(fields: [unidade_id], references: [id], onDelete: Cascade)

  area_conhecimento_id Int?
  area_conhecimento    area_conhecimento? @relation(fields: [area_conhecimento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  avaliador_id Int?
  avaliador    usuario? @relation("avaliador_projeto", fields: [avaliador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  corpo_projeto          corpo_projeto?
  anexo_projeto_pesquisa anexo_projeto_pesquisa?
  edital_rel             edital?                 @relation(fields: [edital_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  atividades            atividade_projeto_pesquisa[]
  objetivos             pesquisa_objetivo[]
  palavra_chave         palavra_chave[]
  plano_trabalho        plano_trabalho[]
  historico_avaliacao   historico_avaliacao[]
  categoria             categoria_edital             @relation(fields: [categoria_id], references: [id])
  projeto_avaliacao     projeto_avaliacao[]
  membros               membro_projeto[]
  relatorios            relatorio[]
  certificados          certificado[]
  projetoMembros        projeto_membro[]
  projetoMembroExternos projeto_membro_externo[]
}

model grupo_pesquisa {
  id         Int     @id @default(autoincrement())
  titulo     String  @db.VarChar(255)
  lider      String  @db.VarChar(255)
  vice_lider String? @db.VarChar(255)

  area_conhecimento_id Int
  area_conhecimento    area_conhecimento @relation(fields: [area_conhecimento_id], references: [id])

  grupo_pesquisa_linhas grupo_pesquisa_linha[]
  projetoPesquisas      projeto_pesquisa[]
}

model grupo_pesquisa_linha {
  id                Int            @id @default(autoincrement())
  linha             String         @db.VarChar(512)
  grupo_pesquisa_id Int
  grupo_pesquisa    grupo_pesquisa @relation(fields: [grupo_pesquisa_id], references: [id])
}

model projeto_membro {
  id           Int               @id @default(autoincrement())
  user_id      Int
  funcao       TipoMembroProjeto
  ch_dedicadas Int
  projeto_id   Int

  user             usuario          @relation(fields: [user_id], references: [id])
  projeto_pesquisa projeto_pesquisa @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
}

model projeto_membro_externo {
  id          Int                   @id @default(autoincrement())
  funcao      TipoMembroProjeto
  ch_dedicada Int
  cpf         String?               @db.VarChar(25) // nulo significa pessoa estrangeira (sem cpf)
  nome        String                @db.VarChar(255)
  email       String                @db.VarChar(255)
  sexo        TipoSexo
  formacao    MembroExternoFormacao
  tipo        TipoMembroExterno
  projeto_id  Int

  projeto_pesquisa projeto_pesquisa @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
}

model historico_avaliacao {
  id             Int             @id @default(autoincrement())
  projeto_id     Int
  avaliador_id   Int
  status         SituacaoProjeto
  observacao     String?         @db.Text
  data_avaliacao DateTime        @default(now()) @db.Timestamp(6)

  projeto_pesquisa projeto_pesquisa @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  avaliador        usuario          @relation("avaliador_historico", fields: [avaliador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model projeto_avaliacao {
  id            Int      @id @default(autoincrement())
  avaliador_id  Int
  projeto_id    Int
  descricao     String?  @db.Text
  criado_em     DateTime @default(now()) @db.Timestamp(6)
  atualizado_em DateTime @default(now()) @updatedAt @db.Timestamp(6)

  avaliador        usuario          @relation("avaliador_projeto_avaliacao", fields: [avaliador_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projeto_pesquisa projeto_pesquisa @relation(fields: [projeto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notas            avaliacao_nota[]
}

model criterio_avaliacao {
  id            Int       @id @default(autoincrement())
  nome          String    @unique
  descricao     String?   @db.Text
  peso          Float
  nota_maxima   Float
  ativo         Boolean   @default(true)
  criado_em     DateTime  @default(now()) @db.Timestamp(6)
  atualizado_em DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  desativado_em DateTime? @db.Timestamp(6)

  notas avaliacao_nota[]
}

model avaliacao_nota {
  id                    Int    @id @default(autoincrement())
  avaliacao_id          Int?
  criterio_avaliacao_id Int?
  nota                  Float?

  avaliacao          projeto_avaliacao?  @relation(fields: [avaliacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  criterio_avaliacao criterio_avaliacao? @relation(fields: [criterio_avaliacao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model objetivo_desenvolvimento_sustentavel {
  id                Int                 @id @default(autoincrement())
  tipo              String              @unique
  pesquisa_objetivo pesquisa_objetivo[]
}

model pesquisa_objetivo {
  pesquisa_id Int
  objetivo_id Int
  pesquisa    projeto_pesquisa                     @relation(fields: [pesquisa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  objetivo    objetivo_desenvolvimento_sustentavel @relation(fields: [objetivo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([pesquisa_id, objetivo_id])
}

model funcao {
  id               Int                @id @default(autoincrement())
  nome             String             @unique
  descricao        String?
  criado_em        DateTime           @default(now()) @db.Timestamp(6)
  atualizado_em    DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  funcao_permissao funcao_permissao[]
  usuario          usuario[]
}

model funcao_permissao {
  funcao_id    Int
  permissao_id Int
  permissao    permissao @relation(fields: [permissao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcao       funcao    @relation(fields: [funcao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([funcao_id, permissao_id])
}

model usuario {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String
  senha         String
  criado_em     DateTime @default(now()) @db.Timestamp(6)
  atualizado_em DateTime @default(now()) @updatedAt @db.Timestamp(6)

  funcao_id Int
  funcao    funcao @relation(fields: [funcao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  anexo               anexo[]
  discente            discente[]
  docente             docente[]
  plano_trabalho      plano_trabalho[]
  projetos_avaliados  projeto_pesquisa[]          @relation("avaliador_projeto")
  historico_avaliacao historico_avaliacao[]       @relation("avaliador_historico")
  projeto_avaliacao   projeto_avaliacao[]         @relation("avaliador_projeto_avaliacao")
  membros_projeto     membro_projeto[]
  certificados        certificado[]
  dados_bancarios     dados_bancarios_indicacao[]
  projetoMembros      projeto_membro[]
}

model cota_bolsa {
  id                           Int                @id @default(autoincrement())
  codigo                       String?            @unique @db.VarChar(255)
  relatorio_anual              Boolean
  orgao_financiador            String             @db.Text
  descricao                    String             @db.Text
  periodo_validade_id          Int
  envio_relatorios_parciais_id Int
  envio_relatorios_finais_id   Int
  cadastro_plano_voluntario_id Int
  editais                      edital[]
  periodo_validade             periodo_cota_bolsa @relation("periodo_validade", fields: [periodo_validade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodo_relatorio_parcial    periodo_cota_bolsa @relation("periodo_relatorio_parcial", fields: [envio_relatorios_parciais_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodo_relatorio_final      periodo_cota_bolsa @relation("periodo_relatorio_final", fields: [envio_relatorios_finais_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodo_cadastro_voluntario  periodo_cota_bolsa @relation("periodo_cadastro_voluntario", fields: [cadastro_plano_voluntario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model periodo_cota_bolsa {
  id                              Int          @id @default(autoincrement())
  inicio                          DateTime     @db.Date
  fim                             DateTime     @db.Date
  cotas_validade                  cota_bolsa[] @relation("periodo_validade")
  cotas_relatorio_parcial         cota_bolsa[] @relation("periodo_relatorio_parcial")
  cotas_relatorio_final           cota_bolsa[] @relation("periodo_relatorio_final")
  cotas_cadastro_plano_voluntario cota_bolsa[] @relation("periodo_cadastro_voluntario")
}

model orgao_financiador {
  id            Int      @id @default(autoincrement())
  nome          String   @unique @db.VarChar(255)
  criado_em     DateTime @default(now()) @db.Timestamp(6)
  atualizado_em DateTime @default(now()) @updatedAt @db.Timestamp(6)
  bolsas        bolsa[]
}

model funcao_projeto {
  id            Int                    @id @default(autoincrement())
  nome          String                 @unique @db.VarChar(255)
  descricao     String?                @db.Text
  categoria     CategoriaFuncaoProjeto
  ativo         Boolean                @default(true)
  criado_em     DateTime               @default(now()) @db.Timestamp(6)
  atualizado_em DateTime               @default(now()) @updatedAt @db.Timestamp(6)
  membros       membro_projeto[]
}

model membro_projeto {
  id                  Int      @id @default(autoincrement())
  projeto_pesquisa_id Int
  usuario_id          Int
  funcao_projeto_id   Int
  ativo               Boolean  @default(true)
  criado_em           DateTime @default(now()) @db.Timestamp(6)

  projeto_pesquisa projeto_pesquisa @relation(fields: [projeto_pesquisa_id], references: [id], onDelete: Cascade)
  usuario          usuario          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcao_projeto   funcao_projeto   @relation(fields: [funcao_projeto_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([projeto_pesquisa_id, usuario_id, funcao_projeto_id])
}

model relatorio {
  id                  Int             @id @default(autoincrement())
  projeto_pesquisa_id Int
  tipo                TipoRelatorio
  status              StatusRelatorio @default(PENDENTE)
  prazo_fim           DateTime        @db.Date
  enviado_em          DateTime?       @db.Timestamp(6)
  criado_em           DateTime        @default(now()) @db.Timestamp(6)

  projeto_pesquisa projeto_pesquisa @relation(fields: [projeto_pesquisa_id], references: [id], onDelete: Cascade)
}

model certificado {
  id                  Int      @id @default(autoincrement())
  usuario_id          Int
  projeto_pesquisa_id Int?
  tipo                String   @db.VarChar(255)
  codigo              String   @unique @db.VarChar(255)
  emitido_em          DateTime @db.Timestamp(6)
  criado_em           DateTime @default(now()) @db.Timestamp(6)

  usuario          usuario           @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projeto_pesquisa projeto_pesquisa? @relation(fields: [projeto_pesquisa_id], references: [id], onDelete: SetNull)
}

model parametro_modulo_pesquisa {
  id                               Int      @id @default(1)
  late_submission_tolerance_days   Int      @default(0)
  max_renewals_per_project         Int      @default(0)
  max_project_duration_months      Int      @default(12)
  max_quota_requests_per_project   Int      @default(1)
  max_work_plans_per_advisor       Int      @default(5)
  scholarship_change_cutoff_day    Int      @default(20)
  email_scholarship_changes        String   @default("") @db.VarChar(255)
  email_invention_notifications    String   @default("") @db.VarChar(255)
  allow_partial_reports_ic         Boolean  @default(false)
  allow_independent_enic_summaries Boolean  @default(false)
  enic_summaries_per_reviewer      Int      @default(5)
  atualizado_em                    DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model bolsa {
  id                          Int                        @id @default(autoincrement())
  descricao                   String                     @db.Text
  categoria                   String                     @db.Text
  dia_limite_indicacao        Int
  dia_limite_finalizacao      Int
  niveis                      String                     @db.Bit(3)
  vinculado_cota              Boolean
  necessita_relatorio         Boolean
  necessidade_dados_bancarios Boolean
  possui_bancos_exclusivos    Boolean
  possui_tipo_conta_excls     Boolean
  envio_relatorio_inicio      DateTime                   @db.Date
  envio_relatorio_fim         DateTime                   @db.Date
  orgao_id                    Int?
  orgao                       orgao_financiador?         @relation(fields: [orgao_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  valor                       Decimal?                   @db.Decimal(12, 2)
  permite_acumulo             Boolean                    @default(false)
  edital_cota_distribuicao    edital_cota_distribuicao[]
}

model categoria_edital {
  id                Int                @id @default(autoincrement())
  denominacao       String             @unique @db.VarChar(255)
  ordem             Int                @unique
  ativo             Boolean
  editais           edital[]
  projetos_pesquisa projeto_pesquisa[]
}

model tipo_usuario {
  id        Int           @id @default(autoincrement())
  nome      String        @unique @db.VarChar(255)
  descricao String?       @db.Text
  publicos  PublicoAlvo[]
  ativo     Boolean       @default(true)
}

