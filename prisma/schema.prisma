generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model anexo {
  id            BigInt   @id @default(autoincrement())
  usuario_id    BigInt
  arquivo       Bytes
  tipo          String   @db.VarChar(255)
  criado_em     DateTime @db.Timestamp(6)
  atualizado_em DateTime @db.Timestamp(6)
  usuario       usuario  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model anexo_projeto_pesquisa {
  id                  BigInt            @id @default(autoincrement())
  projeto_pesquisa_id BigInt            @unique
  arquivo             Bytes
  tipo                String            @db.VarChar(255)
  projeto_pesquisa    projeto_pesquisa? @relation(fields: [projeto_pesquisa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model area_conhecimento {
  id               BigInt             @id @default(autoincrement())
  grande_area      String
  area             String
  sub_area         String
  especialidade    String
  projeto_pesquisa projeto_pesquisa[]
}

model atividade {
  id         BigInt       @id @default(autoincrement())
  atividade  BigInt
  mes_id     BigInt
  mes        mes          @relation(fields: [mes_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cronograma cronograma[]
}

model corpo_plano_trabalho {
  id             BigInt           @id @default(autoincrement())
  titulo         String
  introducao     String
  objetivos      String
  metodologia    String
  referencias    String
  plano_trabalho plano_trabalho[]
}

model corpo_projeto {
  id               BigInt             @id @default(autoincrement())
  resumo           String
  introducao       String
  objetivos        String
  metodologia      String
  referencias      String
  projeto_pesquisa projeto_pesquisa[]
}

model cronograma {
  id                     BigInt             @id @default(autoincrement())
  data_inicio            DateTime           @db.Date
  data_fim               DateTime           @db.Date
  atividade_id           BigInt
  atividade              atividade          @relation(fields: [atividade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plano_trabalho_items   plano_trabalho[]   @relation("plano_trabalho_cronograma")
  projeto_pesquisa_items projeto_pesquisa[] @relation("projeto_pesquisa_cronograma")
}

model discente {
  id             BigInt           @id @default(autoincrement())
  usuario_id     BigInt
  usuario        usuario          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plano_trabalho plano_trabalho[]
}

model docente {
  id         BigInt  @id @default(autoincrement())
  usuario_id BigInt
  usuario    usuario @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model localidade {
  id                          BigInt             @id @default(autoincrement())
  departamento                String
  centro                      String
  unidade                     BigInt
  projeto_pesquisa_localidade projeto_pesquisa[] @relation("projeto_pesquisa_localidade")
}

model mes {
  id        BigInt      @id @default(autoincrement())
  data      DateTime    @db.Date
  atividade atividade[]
}

model palavra_chave {
  id               BigInt             @id @default(autoincrement())
  palavra_chave    String
  lingua           String             @db.VarChar(255)
  projeto_pesquisa projeto_pesquisa[]
}

model permissao {
  id               BigInt             @id @default(autoincrement())
  nome             String             @unique
  descricao        String?
  criado_em        DateTime           @default(now()) @db.Timestamp(6)
  atualizado_em    DateTime           @default(now()) @db.Timestamp(6)
  funcao_permissao funcao_permissao[]
}

model plano_trabalho {
  id                   BigInt               @id @default(autoincrement())
  discente_id          BigInt
  usuario_id           BigInt
  modalidade           String               @db.VarChar(255)
  status               String
  tipo_bolsa           String               @db.VarChar(255)
  cronograma_id        BigInt
  direcionamento_plano String
  corpo_id             BigInt
  corpo_plano_trabalho corpo_plano_trabalho @relation(fields: [corpo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cronograma           cronograma           @relation("plano_trabalho_cronograma", fields: [cronograma_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discente             discente             @relation(fields: [discente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario              usuario              @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projeto_pesquisa     projeto_pesquisa[]
}

model projeto_pesquisa {
  id                     BigInt                  @id @default(autoincrement())
  codigo                 String
  tipo                   String                  @db.VarChar(255)
  titulo                 String
  categoria              String
  situacao               String                  @map("situação")
  localidade_id          BigInt
  area_conhecimento_id   BigInt
  palavra_chave_id       BigInt
  vigencia               DateTime                @db.Timestamp(6)
  plano_trabalho_id      BigInt
  corpo_id               BigInt
  edital                 String
  cota                   String
  cronograma_id          BigInt
  area_conhecimento      area_conhecimento       @relation(fields: [area_conhecimento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  corpo_projeto          corpo_projeto           @relation(fields: [corpo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cronograma             cronograma              @relation("projeto_pesquisa_cronograma", fields: [cronograma_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  anexo_projeto_pesquisa anexo_projeto_pesquisa?
  localidade             localidade              @relation("projeto_pesquisa_localidade", fields: [localidade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  palavra_chave          palavra_chave           @relation(fields: [palavra_chave_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plano_trabalho         plano_trabalho          @relation(fields: [plano_trabalho_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model funcao {
  id               BigInt             @id @default(autoincrement())
  nome             String             @unique
  descricao        String?
  criado_em        DateTime           @default(now()) @db.Timestamp(6)
  atualizado_em    DateTime           @default(now()) @db.Timestamp(6)
  funcao_permissao funcao_permissao[]
  usuario          usuario[]
}

model funcao_permissao {
  funcao_id    BigInt
  permissao_id BigInt
  permissao    permissao @relation(fields: [permissao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  funcao       funcao    @relation(fields: [funcao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([funcao_id, permissao_id])
}

model usuario {
  id             BigInt           @id @default(autoincrement())
  nome           String
  email          String
  senha          String
  criado_em      DateTime         @db.Timestamp(6)
  atualizado_em  DateTime         @db.Timestamp(6)
  funcao_id      BigInt
  anexo          anexo[]
  discente       discente[]
  docente        docente[]
  plano_trabalho plano_trabalho[]
  funcao         funcao           @relation(fields: [funcao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
